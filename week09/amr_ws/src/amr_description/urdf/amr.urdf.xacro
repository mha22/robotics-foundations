<?xml version="1.0"?>
<robot name="amr01" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="use_sim" default="true"/>

  <!-- Includes -->
  <xacro:include filename="$(find amr_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find amr_description)/urdf/amr_base.xacro"/>
  <xacro:include filename="$(find amr_description)/urdf/amr_ros2_control.xacro"/>

  <!-- ros2_control block -->
  <xacro:amr_ros2_control use_sim="$(arg use_sim)"/>

  <!-- Gazebo Sim ros2_control plugin -->
  <gazebo>
    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    </plugin>
  </gazebo>

</robot>
